# /opt/habitat-mail/backup.env (root only). An R2 token with Object Read & Write on habitat-backups
# (the same bucket Habitat's database backups use; mail goes under mail/).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BACKUP_BUCKET=habitat-backups
# BACKUP_PASSPHRASE is generated by setup.sh below. Keep a copy in your password manager.
